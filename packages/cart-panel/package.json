{
	"name": "@magic-spells/cart-panel",
	"version": "2.0.0",
	"description": "Shopping cart panel web component for Shopify. Manages cart data and AJAX, delegates modal behavior to dialog-panel. The root import registers the panel and the cart item; each is also available on its own subpath.",
	"author": "Cory Schulz",
	"license": "MIT",
	"type": "module",
	"main": "dist/index.esm.js",
	"module": "dist/index.esm.js",
	"unpkg": "dist/index.min.js",
	"style": "dist/index.css",
	"exports": {
		".": {
			"import": "./dist/index.esm.js",
			"default": "./dist/index.esm.js"
		},
		"./css": "./dist/index.css",
		"./css/min": "./dist/index.min.css",
		"./panel": {
			"import": "./dist/cart-panel.esm.js",
			"default": "./dist/cart-panel.esm.js"
		},
		"./panel/css": "./dist/cart-panel.css",
		"./panel/css/min": "./dist/cart-panel.min.css",
		"./cart-item": {
			"import": "./dist/cart-item.esm.js",
			"default": "./dist/cart-item.esm.js"
		},
		"./cart-item/css": "./dist/cart-item.css",
		"./cart-item/css/min": "./dist/cart-item.min.css"
	},
	"sideEffects": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/magic-spells/cart.git",
		"directory": "packages/cart-panel"
	},
	"homepage": "https://github.com/magic-spells/cart/tree/main/packages/cart-panel#readme",
	"bugs": {
		"url": "https://github.com/magic-spells/cart/issues"
	},
	"keywords": [
		"cart-panel",
		"cart-item",
		"web-components",
		"e-commerce",
		"shopping-cart",
		"custom-elements",
		"shopify",
		"modal",
		"dialog",
		"accessibility",
		"a11y"
	],
	"files": [
		"dist/",
		"src/",
		"shopify/"
	],
	"scripts": {
		"build": "NODE_ENV=production node scripts/build.mjs",
		"build:demo": "DEMO_BUILD=1 node scripts/build.mjs",
		"dev": "NODE_ENV=development node scripts/build.mjs",
		"lint": "eslint src/ scripts/",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"browserslist": [
		"last 2 versions",
		"not dead",
		"not ie <= 11"
	],
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@magic-spells/vite-plugin-live-reload": "^0.1.0",
		"eslint": "^9.38.0",
		"globals": "^15.15.0",
		"lightningcss": "^1.29.3",
		"prettier": "^3.3.3",
		"terser": "^5.16.0",
		"vite": "^8.0.10"
	},
	"dependencies": {
		"@magic-spells/event-emitter": "^0.1.0"
	},
	"peerDependencies": {
		"@magic-spells/dialog-panel": "^2.0.0",
		"@magic-spells/quantity-input": "^1.0.0",
		"@magic-spells/quantity-modifier": "^0.2.0"
	},
	"peerDependenciesMeta": {
		"@magic-spells/dialog-panel": {
			"optional": true
		},
		"@magic-spells/quantity-input": {
			"optional": true
		},
		"@magic-spells/quantity-modifier": {
			"optional": true
		}
	}
}
